        <mxCell id="n03" value="&lt;b&gt;03 &amp;#160;Clean&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Sentinels, physical ranges, gaps&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Register wraps repaired: 6&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;8 quality gates&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27; style=&#x27;font-size:10px;color:#5a6570&#x27;&gt;mastermeter1_hourly_clean.parquet&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="280" height="150" as="geometry" /></mxCell>

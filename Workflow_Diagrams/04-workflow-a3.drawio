        <mxCell id="n02" value="&lt;b&gt;02 &amp;#160;Ingest&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Complete 5 minute grid&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;1,767,903 rows&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;5 minute and hourly stores&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27; style=&#x27;font-size:10px;color:#5a6570&#x27;&gt;mastermeter1_5min.parquet&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="740" y="135" width="280" height="150" as="geometry" /></mxCell>

<mxfile host="app.diagrams.net"><diagram id="09-system-architecture-a4" name="09-system-architecture-a4"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="1410" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="PRT661 Solar Generation Forecasting" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#1b2a4a;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="26" as="geometry"/></mxCell><mxCell id="c4" value="System Architecture as Built at Assessment 4" style="text;html=1;fontFamily=Helvetica;fontSize=18;fontColor=#1b2a4a;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1000" height="26" as="geometry"/></mxCell><mxCell id="c5" value="DKASC Alice Springs · Master Meter 1, 2008 to 2025 · site telemetry 2024 and 2025 · Theme 2 Predictive Analytics" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#5f6b7a;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1000" height="18" as="geometry"/></mxCell><mxCell id="c6" value="Objective: forecast solar 1 and 24 hours ahead with calibrated uncertainty, plan the site battery each night, keep the system healthy" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1b2a4a;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="86" width="1000" height="18" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:13px;color:#1e7a46&quot;&gt;7. Workflow Automation (cross cutting)&lt;/b&gt;&lt;br&gt;Notebook chain 01 to 08 run in order · SCRUM keyed commits on feature branches · reviewed pull requests · nightly schedule and monthly refit defined" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;align=center;verticalAlign=middle;fillColor=#e9f5ef;strokeColor=#1e7a46;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="1000" height="62" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;DKASC Portal&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#5f6b7a&quot;&gt;external source&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#1e7a46&quot;&gt;Master Meter 1 · primary · 1,767,903 rows&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#1f5fae&quot;&gt;Site telemetry 2024 and 2025 · 210,779 rows&lt;/b&gt;&lt;br&gt;battery, site solar, demand, grid&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;spacingTop=14;fillColor=#ffffff;strokeColor=#8a94a3;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="205" width="310" height="180" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;1. Data Acquisition&lt;/b&gt;&lt;br&gt;&lt;br&gt;Profile all 19 extracts first&lt;br&gt;Select the weather complete extract&lt;br&gt;Reindex to a complete 5 minute grid&lt;br&gt;A3: telemetry, sign convention tested&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="365" y="205" width="310" height="180" as="geometry"/></mxCell><mxCell id="c10" value="DELIVERED" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1e7a46;fillColor=#cddcd6;strokeColor=none;" vertex="1" parent="c9"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;2. Data Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Snappy Parquet, columnar&lt;br&gt;5 minute, hourly and feature stores&lt;br&gt;A3 and A4: forecast, dispatch,&lt;br&gt;demand and monitoring stores&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="205" width="310" height="180" as="geometry"/></mxCell><mxCell id="c12" value="DELIVERED" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1e7a46;fillColor=#cddcd6;strokeColor=none;" vertex="1" parent="c11"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;3. Data Processing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sentinels, physical ranges, gaps&lt;br&gt;Register wraps at 1,000,000 repaired&lt;br&gt;Validated 99.7% against power&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="310" height="180" as="geometry"/></mxCell><mxCell id="c14" value="DELIVERED" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1e7a46;fillColor=#cddcd6;strokeColor=none;" vertex="1" parent="c13"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;4. Feature Engineering&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solar geometry, clear sky index&lt;br&gt;Lags 1, 2, 3, 24, 168 h, rolling&lt;br&gt;A4: demand lags, weekday, temperature&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="365" y="430" width="310" height="180" as="geometry"/></mxCell><mxCell id="c16" value="DELIVERED" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1e7a46;fillColor=#cddcd6;strokeColor=none;" vertex="1" parent="c15"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;5. Solar Forecasting&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gradient boosting, 3 baselines&lt;br&gt;4 walk forward folds, 2019 to 2025&lt;br&gt;1 h MAE 3.66 kW · 24 h MAE 6.96 kW&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="430" width="310" height="180" as="geometry"/></mxCell><mxCell id="c18" value="DELIVERED" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1e7a46;fillColor=#cddcd6;strokeColor=none;" vertex="1" parent="c17"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c19" value="ASSESSMENT 3 · from forecast to decision (notebook 06)" style="text;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#1f5fae;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="160" y="631" width="720" height="18" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;5a. Interval Calibration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Crossed quantiles repaired: 3,929 rows&lt;br&gt;Rolling conformal, 30 day window&lt;br&gt;Daylight coverage 80.1% / 80.0%&lt;br&gt;(A2: 0.772 / 0.706)&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e3eefc;strokeColor=#1f5fae;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="655" width="310" height="180" as="geometry"/></mxCell><mxCell id="c21" value="DELIVERED IN A3" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1f5fae;fillColor=#cfe0f6;strokeColor=none;" vertex="1" parent="c20"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c22" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;5c. Nightly Battery Plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;22:00 decision: grid energy to buy&lt;br&gt;Compared with rules, perfect foresight&lt;br&gt;Caution chosen on 2024, tested on 2025&lt;br&gt;Saving 22.3% · value $3,419&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e3eefc;strokeColor=#1f5fae;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="365" y="655" width="310" height="180" as="geometry"/></mxCell><mxCell id="c23" value="DELIVERED IN A3" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1f5fae;fillColor=#cfe0f6;strokeColor=none;" vertex="1" parent="c22"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c24" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;5b. Site and Battery Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;demand = solar + grid + battery&lt;br&gt;Drift: February 2024, K = 1.135&lt;br&gt;Battery: 354 kWh, 115 kW&lt;br&gt;Round trip 82.8% on real cycles&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e3eefc;strokeColor=#1f5fae;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="655" width="310" height="180" as="geometry"/></mxCell><mxCell id="c25" value="DELIVERED IN A3" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#1f5fae;fillColor=#cfe0f6;strokeColor=none;" vertex="1" parent="c24"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c26" value="ASSESSMENT 4 · better decisions, kept healthy, in front of the operator (notebooks 07, 08, dashboard)" style="text;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#6a3fa0;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="856" width="880" height="18" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;5d. Demand Forecasting&lt;/b&gt;&lt;br&gt;&lt;br&gt;Five approaches, monthly walk forward&lt;br&gt;Gradient boosting MAE 24.9 kW&lt;br&gt;54% below the A3 mean (54.5 kW)&lt;br&gt;Share of perfect benefit 39% to 70%&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="310" height="180" as="geometry"/></mxCell><mxCell id="c28" value="DELIVERED IN A4" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#6a3fa0;fillColor=#e2d6f2;strokeColor=none;" vertex="1" parent="c27"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c29" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;5e. Monitoring and Retraining&lt;/b&gt;&lt;br&gt;&lt;br&gt;Daily error and coverage checks&lt;br&gt;Fixed limits from 2019 to 2020&lt;br&gt;Drift check on site solar ratio&lt;br&gt;Monthly refit: 24.9 vs 41.3 kW static&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="365" y="880" width="310" height="180" as="geometry"/></mxCell><mxCell id="c30" value="DELIVERED IN A4" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#6a3fa0;fillColor=#e2d6f2;strokeColor=none;" vertex="1" parent="c29"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c31" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;6. Decision Support Dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Streamlit, six pages&lt;br&gt;Battery rule rerun live per setting&lt;br&gt;Scenario lab: tariff, caution, size&lt;br&gt;Health and pipeline pages&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="880" width="310" height="180" as="geometry"/></mxCell><mxCell id="c32" value="DELIVERED IN A4" style="rounded=1;arcSize=30;html=1;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#6a3fa0;fillColor=#e2d6f2;strokeColor=none;" vertex="1" parent="c31"><mxGeometry x="15" y="142" width="280" height="26" as="geometry"/></mxCell><mxCell id="c33" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px;color:#1b2a4a&quot;&gt;FORECAST, PLAN AND HEALTH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#5f6b7a&quot;&gt;project deliverable&lt;/i&gt;&lt;br&gt;Solar 1 and 24 h ahead with 80% intervals&lt;br&gt;Demand for tomorrow's planning hours&lt;br&gt;Grid energy to buy tonight · health alerts&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="1125" width="360" height="140" as="geometry"/></mxCell><mxCell id="c34" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;DECISION SUPPORTED&lt;/b&gt;&lt;br&gt;&lt;i&gt;the operator decides; the system advises&lt;/i&gt;&lt;br&gt;How much off peak grid energy should&lt;br&gt;the battery store tonight?&lt;br&gt;&lt;b&gt;$3,943 better than rules without a forecast&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#b3243b;verticalAlign=top;spacingTop=10;fillColor=#fdecee;strokeColor=#b3243b;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="1125" width="360" height="140" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style=&quot;font-size:13px;color:#b3243b&quot;&gt;8. Governance and Monitoring (cross cutting)&lt;/b&gt;&lt;br&gt;All quality gates pass · decision support, not control · alert limits fixed · settings chosen on 2024, judged on 2025 · risk register and AI disclosure" style="rounded=1;arcSize=12;ht
  <diagram id="sysarch-a3" name="System architecture A3">
    <mxGraphModel dx="1600" dy="1300" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1210" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
                <mxCell id="t1" value="&lt;b&gt;PRT661 Solar Generation Forecasting&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=21;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1000" height="28" as="geometry" /></mxCell>
        <mxCell id="t2" value="&lt;b&gt;System Architecture as Built at Assessment 3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=21;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1000" height="28" as="geometry" /></mxCell>
        <mxCell id="t3" value="DKASC Alice Springs · Master Meter 1, 2008 to 2025 · site telemetry 2024 and 2025 · Theme 2 Predictive Analytics and Forecasting" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#5a6570;" vertex="1" parent="1"><mxGeometry x="20" y="82" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="t4" value="&lt;i&gt;Objective: forecast generation 1 and 24 hours ahead with calibrated uncertainty, and use it to plan the site battery each night&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="20" y="104" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="band7" value="&lt;b&gt;&lt;font color=&#x27;#1f7a4d&#x27;&gt;7. Workflow Automation &amp;#160;(cross-cutting)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c5c42&#x27;&gt;Reproducible notebook chain 01 to 06 &amp;#160;·&amp;#160; quality gates with thresholds &amp;#160;·&amp;#160; feature branches, SCRUM-keyed commits, reviewed pull requests &amp;#160;·&amp;#160; scheduled orchestration planned for A4&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef7f1;strokeColor=#1f7a4d;strokeWidth=2;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="138" width="965" height="56" as="geometry" /></mxCell>
        <mxCell id="src" value="&lt;b&gt;DKASC Portal&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&#x27;font-size:11px;color:#5a6570&#x27;&gt;external source&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&#x27;#1f7a4d&#x27;&gt;Master Meter 1 &amp;#160;·&amp;#160; PRIMARY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;1,767,903 rows · weather + target&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&#x27;#1f5fae&#x27;&gt;Site telemetry 2024 and 2025 &amp;#160;·&amp;#160; A3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;battery, site solar, demand, grid · 210,779 rows&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8494;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;spacingTop=10;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;1. Data Acquisition&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Profile all 19 extracts first&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Select the weather-complete extract&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Reindex to a complete 5 min grid&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="365" y="225" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="c1_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="357" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;2. Data Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Snappy Parquet, columnar&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;5 minute and hourly stores&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;A3: forecast and dispatch stores&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="700" y="225" width="295" height="165" as="geometry" /></mxCell>
        <mxCell id="c2_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="357" width="275" height="24" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;3. Data Processing&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Sentinels · physical ranges · gaps&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Register wraps at 1,000,000: 6 fixed&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Validated 99.7% against power&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="c3_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;b&gt;4. Feature Engineering&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Solar geometry · clear sky index&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Lags 1, 2, 3, 24, 168 h · rolling&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Degradation: -0.454 kW/year&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="365" y="450" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="c4_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="582" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="c5" value="&lt;b&gt;5. Analytics and ML&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Gradient boosting · 3 baselines&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;4 walk-forward folds, 2019 to 2025&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;1 h MAE 3.61 · 24 h MAE 6.96 kW&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#1f5fae&#x27;&gt;A3: all out of sample forecasts saved&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="295" height="165" as="geometry" /></mxCell>
        <mxCell id="c5_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="582" width="275" height="24" as="geometry" /></mxCell>
        <mxCell id="tagA3" value="&lt;b&gt;NEW IN ASSESSMENT 3 &amp;#160;·&amp;#160; from forecast to decision &amp;#160;(notebook 06)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#1f5fae;" vertex="1" parent="1"><mxGeometry x="30" y="652" width="965" height="18" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;5a. Interval Calibration&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Crossed quantiles repaired: 3,929 rows&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Rolling conformal, 30 day window&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Daylight coverage 80.1% / 80.0%&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#5a6570&#x27;&gt;(A2, latest fold: 0.772 / 0.706)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3effc;strokeColor=#1f5fae;strokeWidth=2.5;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#133d73;" vertex="1" parent="1"><mxGeometry x="30" y="675" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="a1_s" value="&lt;b&gt;DELIVERED IN A3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f5fae;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f5fae;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="807" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;5c. Dispatch Simulation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Nightly 22:00 grid charging decision&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;vs no battery, rules, perfect foresight&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Caution set on 2024, tested on 2025&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Saving 22.3% · 47% of perfect benefit&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3effc;strokeColor=#1f5fae;strokeWidth=2.5;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#133d73;" vertex="1" parent="1"><mxGeometry x="365" y="675" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="a3_s" value="&lt;b&gt;DELIVERED IN A3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f5fae;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f5fae;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="375" y="807" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;5b. Site and Battery Model&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Energy balance: demand = solar + grid + battery&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Drift: February 2024 change, K = 1.135&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Battery from telemetry: 354 kWh, 115 kW&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Round trip 82.8% on real cycles&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3effc;strokeColor=#1f5fae;strokeWidth=2.5;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#133d73;" vertex="1" parent="1"><mxGeometry x="700" y="675" width="295" height="165" as="geometry" /></mxCell>
        <mxCell id="a2_s" value="&lt;b&gt;DELIVERED IN A3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f5fae;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f5fae;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="807" width="275" height="24" as="geometry" /></mxCell>
        <mxCell id="c6" value="&lt;b&gt;6. Visualisation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;A2 figures + figures 11 to 14&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Example week of decisions&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;KPI summary: dispatch_results.md&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="c6_s" value="&lt;b&gt;PARTIAL · dashboard not built&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#b5790c;opacity=16;strokeColor=none;fontSize=10;fontColor=#b5790c;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1032" width="280" height="24" as="geometry" /></mxCell>
        <mxCell id="out" value="&lt;b&gt;FORECAST AND DISPATCH PLAN&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&#x27;font-size:11px;color:#5a6570&#x27;&gt;project deliverable&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Generation 1 and 24 h ahead&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;with calibrated 80% intervals&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Nightly grid charge amount for the battery&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#2c3444&#x27;&gt;Evaluated on 17 months of history&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dce6f7;strokeColor=#1e2d5c;strokeWidth=3;verticalAlign=top;spacingTop=10;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1"><mxGeometry x="365" y="900" width="300" height="165" as="geometry" /></mxCell>
        <mxCell id="dec" value="&lt;b&gt;DECISION SUPPORTED&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;evaluated in simulation, not yet deployed&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;How much cheap overnight grid energy&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;should the battery store tonight?&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;&lt;b&gt;$3,419&lt;/b&gt; better than rules without a forecast&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdf0f2;strokeColor=#b3243b;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;spacingTop=10;fontSize=13;fontColor=#b3243b;" vertex="1" parent="1"><mxGeometry x="700" y="900" width="295" height="165" as="geometry" /></mxCell>
        <mxCell id="note" value="&lt;i&gt;The forecast now drives a simulated battery decision. Live deployment, a dashboard and scheduled retraining are planned for Assessment 4.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#5a6570;" vertex="1" parent="1"><mxGeometry x="20" y="1075" width="1000" height="20" as="geometry" /></mxCell>
        <mxCell id="band8" value="&lt;b&gt;&lt;font color=&#x27;#b3243b&#x27;&gt;8. Governance and Monitoring &amp;#160;(cross-cutting)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#7a2030&#x27;&gt;Interval coverage gate now passes &amp;#160;·&amp;#160; February 2024 data drift detected and handled &amp;#160;·&amp;#160; settings chosen on 2024, tested on 2025 &amp;#160;·&amp;#160; AI disclosure &amp;#160;·&amp;#160; dated planning records&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdf0f2;strokeColor=#b3243b;strokeWidth=2;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="1105" width="965" height="56" as="geometry" /></mxCell>
        <mxCell id="legend" value="&lt;font color=&#x27;#1f7a4d&#x27;&gt;&lt;b&gt;green&lt;/b&gt;&lt;/font&gt; delivered in A1 and A2 &amp;#160;·&amp;#160; &lt;font color=&#x27;#1f5fae&#x27;&gt;&lt;b&gt;blue&lt;/b&gt;&lt;/font&gt; delivered in A3 &amp;#160;·&amp;#160; &lt;font color=&#x27;#b5790c&#x27;&gt;&lt;b&gt;amber&lt;/b&gt;&lt;/font&gt; partial &amp;#160;·&amp;#160; dashed arrow: planned" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#5a6570;" vertex="1" parent="1"><mxGeometry x="20" y="1170" width="1000" height="18" as="geometry" /></mxCell>

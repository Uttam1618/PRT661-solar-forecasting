<mxfile host="app.diagrams.net"><diagram id="10-deployment-architecture" name="10-deployment-architecture"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="650" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Deployment Architecture: nightly batch operation" style="text;html=1;fontFamily=Helvetica;fontSize=20;fontColor=#1b2a4a;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1060" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Times are local (ACST). Today the chain runs as notebooks on a laptop; the same steps map onto scheduled cloud jobs." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#5f6b7a;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1060" height="18" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=4;html=1;fillColor=#f7f8fa;strokeColor=#e1e4ea;" vertex="1" parent="1"><mxGeometry x="10" y="75" width="1080" height="165" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;DATA&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;horizontal=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="14" y="75" width="26" height="165" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=4;html=1;fillColor=#f7f8fa;strokeColor=#e1e4ea;" vertex="1" parent="1"><mxGeometry x="10" y="255" width="1080" height="165" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;SCHEDULED JOBS&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;horizontal=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="14" y="255" width="26" height="165" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=4;html=1;fillColor=#f7f8fa;strokeColor=#e1e4ea;" vertex="1" parent="1"><mxGeometry x="10" y="435" width="1080" height="165" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;SERVE AND OPERATE&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;horizontal=0;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="14" y="435" width="26" height="165" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;DKASC meter data&lt;br&gt;site telemetry feed&lt;br&gt;weather (future: NWP)&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#ffffff;strokeColor=#8a94a3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="101" width="180" height="112" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Raw zone&lt;/b&gt;&lt;br&gt;&lt;br&gt;immutable downloads&lt;br&gt;S3 bucket, outside git&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="101" width="180" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Clean and feature zones&lt;/b&gt;&lt;br&gt;&lt;br&gt;Parquet, 5 minute, hourly&lt;br&gt;Glue catalog · Athena SQL&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="101" width="180" height="112" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Plan and health stores&lt;/b&gt;&lt;br&gt;&lt;br&gt;forecasts, dispatch plan&lt;br&gt;monitoring table&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="101" width="180" height="112" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Model registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;versioned models&lt;br&gt;monthly refits kept&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="101" width="180" height="112" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;21:00 Ingest&lt;/b&gt;&lt;br&gt;&lt;br&gt;download, reindex&lt;br&gt;quality gates&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e8edf5;strokeColor=#1b2a4a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="281" width="180" height="112" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;21:15 Forecast&lt;/b&gt;&lt;br&gt;&lt;br&gt;solar 24 h, conformal&lt;br&gt;demand 07:00 to 15:59&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e3eefc;strokeColor=#1f5fae;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="281" width="180" height="112" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;21:30 Check&lt;/b&gt;&lt;br&gt;&lt;br&gt;error and coverage&lt;br&gt;drift on solar ratio&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="281" width="180" height="112" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;22:00 Plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;battery rule&lt;br&gt;grid energy to buy&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#e3eefc;strokeColor=#1f5fae;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="281" width="180" height="112" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;1st of month&lt;/b&gt;&lt;br&gt;&lt;br&gt;refit demand model&lt;br&gt;promote if better&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="281" width="180" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Alerts&lt;/b&gt;&lt;br&gt;&lt;br&gt;email or chat on breach&lt;br&gt;retrain early if persistent&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#fdecee;strokeColor=#b3243b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="461" width="180" height="112" as="geometry"/></mxCell><mxCell id="c22" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;approves tonight's charge&lt;br&gt;keeps manual override&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#fdecee;strokeColor=#b3243b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="461" width="180" height="112" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;line-height:1.5&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1b2a4a&quot;&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Streamlit, read only&lt;br&gt;six pages, CSV export&lt;/div&gt;" style="rounded=1;arcSize=7;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#2c3444;verticalAlign=top;align=center;spacingTop=10;spacingLeft=6;spacingRight=6;fillColor=#efe8f8;strokeColor=#6a3fa0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="461" width="180" height="112" as="geometry"/></mxCell><mxCell id="c24" value="Each job reads the zone its predecessor wrote, as the notebooks do now." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#5f6b7a;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="55" y="481" width="360" height="80" as="geometry"/></mxCell><mxCell id="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1b2a4a;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6a3fa0;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b3243b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b3243b;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6a3fa0;strokeWidth=2;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="Cloud mapping tested in the AWS Data Engineering capstone: S3 zones, Glue crawler and catalog, Athena SQL views. Scheduling (for example EventBridge) is the proposed next step." style="text;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1060" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
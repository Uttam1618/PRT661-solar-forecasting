        <mxCell id="t4" value="&lt;i&gt;Objective: forecast generation 1 to 24 hours ahead so that battery charge and discharge can be scheduled against expected output&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="20" y="104" width="1000" height="20" as="geometry" />

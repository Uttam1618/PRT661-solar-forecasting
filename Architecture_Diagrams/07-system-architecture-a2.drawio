        <mxCell id="dec" value="&lt;b&gt;DECISION SUPPORTED&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;operational use, not a deliverable&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;When should the battery charge,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;and when should it discharge?&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdf0f2;strokeColor=#b3243b;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;spacingTop=10;fontSize=13;fontColor=#b3243b;" vertex="1" parent="1">

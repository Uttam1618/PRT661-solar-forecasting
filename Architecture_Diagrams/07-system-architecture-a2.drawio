        <mxCell id="band7" value="&lt;b&gt;&lt;font color='#1f7a4d'&gt;7. Workflow Automation &amp;#160;(cross-cutting)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c5c42'&gt;Reproducible notebook chain 01 to 05 &amp;#160;·&amp;#160; quality gates with thresholds &amp;#160;·&amp;#160; scheduled orchestration not yet implemented&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef7f1;strokeColor=#1f7a4d;strokeWidth=2;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="138" width="965" height="56" as="geometry" />
        </mxCell>
        <mxCell id="src" value="&lt;b&gt;DKASC Portal&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px;color:#5a6570'&gt;external source&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color='#1f7a4d'&gt;Master Meter 1 &amp;#160;·&amp;#160; PRIMARY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;1,767,903 rows · weather + target&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color='#b3243b'&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#b3243b' style='font-size:11px'&gt;19 yearly extracts: schema evidence only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8494;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;spacingTop=10;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="30" y="225" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;1. Data Acquisition&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Profile all 19 extracts first&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Select the weather-complete extract&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Reindex to a complete 5 min grid&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="365" y="225" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c1_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="375" y="357" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;2. Data Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Snappy Parquet, columnar&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;5 minute and hourly stores&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Queried through DuckDB&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="700" y="225" width="295" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c2_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="710" y="357" width="275" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;3. Data Processing&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Sentinels · physical ranges · gaps&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Register wraps at 1,000,000: 6 fixed&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Validated 99.7% against power&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="30" y="450" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c3_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="582" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;4. Feature Engineering&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Solar geometry · clear sky index&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Lags 1, 2, 3, 24, 168 h · rolling&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Degradation: -0.454 kW/year&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="365" y="450" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="c4_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="375" y="582" width="280" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;5. Analytics and ML&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Gradient boosting · 3 baselines&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;4 walk-forward folds, 2019-2025&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;1 h MAE 3.61 · 24 h MAE 6.96 kW&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="295" height="165" as="geometry" />

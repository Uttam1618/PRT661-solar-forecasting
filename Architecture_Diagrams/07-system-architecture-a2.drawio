        <mxCell id="out" value="&lt;b&gt;FORECAST OUTPUT&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px;color:#5a6570'&gt;project deliverable&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Generation 1 and 24 h ahead&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;with 80% prediction intervals&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Daylight coverage 0.772 / 0.706&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#b3243b'&gt;24 h interval overconfident&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dce6f7;strokeColor=#1e2d5c;strokeWidth=3;verticalAlign=top;spacingTop=10;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">

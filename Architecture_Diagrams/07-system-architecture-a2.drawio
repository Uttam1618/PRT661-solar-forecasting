        <mxCell id="c6" value="&lt;b&gt;6. Visualisation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;11 static figures delivered&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Error by hour and by month&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px;color:#2c3444'&gt;Forecast vs actual with intervals&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaeef7;strokeColor=#3d5280;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#1e2d5c;" vertex="1" parent="1">

        <mxCell id="c5_s" value="&lt;b&gt;DELIVERED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#1f7a4d;opacity=16;strokeColor=none;fontSize=10;fontColor=#1f7a4d;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="710" y="582" width="275" height="24" as="geometry" />
